# Development Environment Configuration
# This file is used when running: npm start

# Application Environment
# Set to 'development' to enable development features
REACT_APP_ENV=development

# FHIR Server URL
# When this contains 'localhost', the app will use mock JSON data
# Mock data location: src/mockData/fhir/*.json
REACT_APP_FHIR_URL=http://localhost:8080/fhir

# Backend API Host
# The Django backend server URL for recruitment/screening data
REACT_APP_API_HOST=http://localhost:3001

# Enable Redux DevTools (automatically enabled in development)
# No need to set explicitly, but documented for reference
